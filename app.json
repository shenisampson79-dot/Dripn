{
  "expo": {
    "name": "StyleWise",
    "slug": "stylewise",
    "version": "1.0.0",
    "description": "StyleWise is your personal fashion advisor powered by AI and a vibrant community. Get instant outfit advice, discover trending styles from top influencers worldwide, and receive daily style tips featuring exclusive bargains from luxury and household brands. Explore daily and weekly special offers from your favorite fashion retailers, and discover local events with personalized outfit suggestions for every occasion. Whether you love athleisure, preppy classics, or countryside chic, StyleWise delivers personalized recommendations, size-inclusive styling, voice comments, and shoppable content. Join millions of fashion enthusiasts sharing outfits, voting on looks, and elevating their style game every day.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stylewise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stylewise.app",
      "infoPlist": {
        "NSCameraUsageDescription": "StyleWise needs camera access to take outfit photos for style advice.",
        "NSPhotoLibraryUsageDescription": "StyleWise needs photo library access to select outfit images for style advice.",
        "NSMicrophoneUsageDescription": "StyleWise needs microphone access to record voice comments on outfits."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "keywords": [
        "fashion",
        "style",
        "outfit",
        "clothing",
        "wardrobe",
        "ootd",
        "lookbook",
        "trends",
        "shopping",
        "deals",
        "bargains",
        "sales",
        "discounts",
        "events",
        "live events",
        "concerts",
        "festivals",
        "parties",
        "nightlife",
        "clubbing",
        "dating",
        "date night",
        "first date",
        "romance",
        "love",
        "matching",
        "travel",
        "flights",
        "holiday",
        "vacation",
        "weekend",
        "getaway",
        "wedding",
        "wedding guest",
        "bridesmaid",
        "prom",
        "graduation",
        "interview",
        "work",
        "office",
        "business",
        "casual",
        "formal",
        "luxury",
        "designer",
        "streetwear",
        "athleisure",
        "gym",
        "fitness",
        "sports",
        "football",
        "soccer",
        "match day",
        "stadium",
        "influencer",
        "celebrity",
        "AI",
        "advice",
        "stylist",
        "personal shopper",
        "beauty",
        "makeup",
        "accessories",
        "shoes",
        "bags",
        "jewelry",
        "watches",
        "sunglasses",
        "winter",
        "summer",
        "spring",
        "autumn",
        "seasonal",
        "plus size",
        "inclusive",
        "mens fashion",
        "womens fashion",
        "unisex",
        "sustainable",
        "vintage",
        "thrift",
        "community",
        "social",
        "share",
        "vote",
        "poll",
        "compare",
        "inspiration",
        "ideas",
        "tips",
        "recommendations"
      ]
    },
    "android": {
      "package": "com.stylewise.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7",
          "dark": {
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-audio"
    ],
    "jsEngine": "hermes",
    "experiments": {
      "reactCompiler": true
    }
  }
}
