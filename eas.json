{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dripn-server.onrender.com"
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dripn-server.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "shenisampson79@gmail.com",
        "ascAppId": "6762082932"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
