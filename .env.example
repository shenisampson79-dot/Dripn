# Copy to .env for local Expo development — do not commit real values.

# Backend API (Dripn-Server on Render)
EXPO_PUBLIC_API_URL=https://dripn-server.onrender.com

# RevenueCat — iOS In-App Purchase (Phases 1–3: subs, DFY, voice credits)
# Required for production/preview EAS builds — also set via eas env:create or eas.json build.*.env
# (EXPO_PUBLIC_* is baked at build time; missing key → "In-app purchases unavailable — rebuild with RevenueCat key")
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Set to true to test Apple IAP in dev builds (requires sandbox Apple ID + native build, not Expo Go)
# EXPO_PUBLIC_FORCE_APPLE_IAP=true

# OAuth / social sign-in (required for Google & Facebook buttons)
# Google Cloud Console → OAuth client IDs (use iOS client for iosClientId if separate)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Optional dedicated iOS client (recommended): EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Apple Sign-In uses native expo-apple-authentication (Capability in Apple Developer + usesAppleSignIn in app.json).
# No EXPO_PUBLIC Apple secret needed on the client.

# Cancel-retention coupons are configured on the SERVER only (STRIPE_CANCEL_COUPON_30 / _50).
# The app sends offer keys (retention_30, retention_50) — never Stripe coupon IDs from the client.

# Optional — server ADMIN_SECRET for analytics API scripts (x-admin-secret header)
# Prefer admin JWT via POST /api/admin/login — do not rely on EXPO_PUBLIC_ADMIN_SECRET for new flows.
# EXPO_PUBLIC_ADMIN_SECRET=

# E2E retention test (scripts/e2e-retention-test.mjs)
# SWEEP_API=https://dripn-server.onrender.com
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_SECRET=
# CRON_SECRET=
# DATABASE_URL=   # optional — seed persona signals in Neon for reliable segment tests
