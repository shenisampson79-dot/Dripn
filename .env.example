# Copy to .env for local Expo development — do not commit real values.

# Backend API (Dripn-Server on Render)
EXPO_PUBLIC_API_URL=https://dripn-server.onrender.com

# OAuth (optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Cancel-retention coupons are configured on the SERVER only (STRIPE_CANCEL_COUPON_30 / _50).
# The app sends offer keys (retention_30, retention_50) — never Stripe coupon IDs from the client.

# Optional — server ADMIN_SECRET for analytics API scripts (x-admin-secret header)
# Prefer admin JWT via POST /api/admin/login — do not rely on EXPO_PUBLIC_ADMIN_SECRET for new flows.
# EXPO_PUBLIC_ADMIN_SECRET=

# E2E retention test (scripts/e2e-retention-test.mjs)
# SWEEP_API=https://dripn-server.onrender.com
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_SECRET=
# CRON_SECRET=
# DATABASE_URL=   # optional — seed persona signals in Neon for reliable segment tests
