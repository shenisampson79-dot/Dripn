{
  "name": "my-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start",
    "start": "npx expo start",
    "start:dev-client": "npx expo start --dev-client --lan",
    "start:dev-client:tunnel": "npx expo start --dev-client --tunnel",
    "start:go": "npx expo start --tunnel --clear",
    "start:lan": "npx expo start --lan --clear",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:web": "npx expo export --platform web --output-dir web-build && node scripts/fix-web-index.js",
    "lint": "npx expo lint",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "i18n:generate": "node scripts/generate-translations.js",
    "i18n:locales": "node scripts/generate-all-locales.js",
    "security:smoke": "node scripts/security-smoke-check.mjs",
    "security:scan-secrets": "node scripts/scan-secrets.mjs",
    "verify:todays-outfit": "npx tsx scripts/verify-todays-outfit-hardening.ts",
    "verify:todays-outfit-rotation": "npx tsx scripts/verify-todays-outfit-date-rotation.ts",
    "verify:notification-open-race": "npx tsx scripts/verify-notification-open-race.ts",
    "verify:entry-router": "npx tsx scripts/verify-entry-router.ts",
    "verify:todays-outfit-ui-contract": "npx tsx scripts/verify-todays-outfit-ui-contract.ts",
    "verify:todays-outfit-control-flow": "npx tsx scripts/verify-todays-outfit-control-flow.ts",
    "verify:allocator": "npx tsx scripts/verify-allocator-hard-validity.ts",
    "verify:weather-outerwear": "npx tsx scripts/verify-weather-outerwear.ts",
    "verify:favorites-weather": "npx tsx scripts/verify-favorites-weather.ts",
    "verify:wear-rules": "npx tsx scripts/verify-wear-rules.ts",
    "verify:decision-contract": "npx tsx scripts/verify-decision-contract.ts",
    "verify:decision-result-presentation": "npx tsx scripts/verify-decision-result-presentation.ts",
    "verify:safe-render": "npx tsx scripts/verify-safe-render.ts",
    "verify:presentation-boundary": "npx tsx scripts/test-presentation-boundary.ts && npx tsx scripts/test-presentation-matrix.ts && npx tsx scripts/test-decision-continuity.ts",
    "verify:outfit-score": "npx tsx scripts/verify-outfit-score.ts",
    "verify:allocation-score": "npx tsx utils/outfitAllocationScore.test.ts",
    "verify:auto-pipeline": "npx tsx utils/outfitAutoAnalysisPipeline.test.ts",
    "verify:pipeline-wire": "npx tsx utils/yoloToPipelineCandidates.test.ts",
    "verify:hybrid-detection": "npx tsx utils/hybridDetectionLayer.test.ts",
    "test:live-regression": "npx tsx utils/livePermanentRegression.test.ts && npx tsx utils/liveFootwearLaunchGate.test.ts && npx tsx utils/liveScoreStability.test.ts && npx tsx utils/liveFootwearGate.test.ts && npx tsx utils/legwearAdvisory.test.ts",
    "verify:live-regression": "npm run test:live-regression && npx tsx utils/liveRegression.test.ts && npx tsx utils/legwearAdvisory.test.ts",
    "verify:fashion-color": "npx tsx utils/fashionColorTaxonomy.test.ts",
    "verify:dual-style-signals": "npx tsx utils/dualStyleSignals.test.ts",
    "verify:feedback-brain": "npx tsx utils/outfitFeedbackBrain.test.ts",
    "verify:gon-hydration": "npx tsx utils/scanCropHydration.test.ts",
    "verify:outfit-mix-occasion": "npx tsx scripts/verify-outfit-mix-occasion.ts",
    "verify:outfit-mix-integrity": "npx tsx scripts/verify-outfit-mix-integrity.ts",
    "verify:ui-integrity": "npx tsx scripts/verify-ui-integrity.ts",
    "verify:ui": "npm run verify:ui-integrity",
    "verify:stylist-chat-scroll": "npx tsx scripts/verify-stylist-chat-scroll.ts",
    "verify:all": "npm run verify:ui-integrity && npm run verify:stylist-chat-scroll && npm run verify:outfit-mix-integrity && npm run verify:outfit-mix-occasion && npm run verify:safe-render && npm run verify:presentation-boundary && npm run test:live-regression",
    "verify:style-coherence": "npx tsx scripts/verify-style-coherence.ts",
    "verify:garment-taxonomy": "npx tsx scripts/verify-garment-taxonomy.ts",
    "verify:garment-image-priority": "npx tsx scripts/verify-garment-image-priority.ts",
    "verify:outfit-intent": "npx tsx scripts/verify-outfit-intent.ts",
    "verify:fallback-outfit": "npx tsx scripts/verify-fallback-outfit.ts",
    "test:currency": "node scripts/test-currency-resolve.mjs",
    "enrich:sloane-brands": "node scripts/enrich-sloane-brands.mjs",
    "ingest:oxford-street": "node scripts/ingest-oxford-street.mjs",
    "apply:oxford-labels": "node scripts/apply-oxford-labels.mjs",
    "build:sloane-signals": "node scripts/enrich-sloane-brands.mjs && node scripts/build-shop-window-signals.mjs",
    "build:shop-window-signals": "node scripts/enrich-sloane-brands.mjs && node scripts/build-shop-window-signals.mjs",
    "prepare:yolo-shop-windows": "node scripts/prepare-yolo-shop-windows.mjs"
  },
