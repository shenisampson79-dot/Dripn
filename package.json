    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "3.6.2",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
